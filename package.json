{
  "name": "useroute",
  "version": "0.2.0",
  "description": "Route — honest model routing observability",
  "license": "MIT",
  "type": "module",
  "bin": {
    "useroute": "src/cli.ts",
    "opencode-routing-dashboard": "src/legacy-bin.ts"
  },
  "files": ["src", "dist", "contrib", "README.md", "LICENSE"],
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "snapshot": "bun src/cli.ts snapshot",
    "start": "bun run build && bun src/cli.ts",
    "dev": "bun run build && bun --watch src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
